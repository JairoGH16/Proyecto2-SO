#!/usr/bin/env python3
"""presion-cpu: cuánta competencia hay por la CPU ahora mismo.

Interfaces del SO: /proc/pressure/cpu (PSI: porcentaje del tiempo en que hubo
procesos listos esperando CPU), /proc/loadavg (carga media y procesos
ejecutables) y /proc/stat (tiempo por CPU, procesos en ejecución y bloqueados).
Uso: presion-cpu [-t SEGUNDOS]
"""
import argparse
import time


def cpus():
    """Devuelve {cpuN: (total, ocioso)} en ticks, leyendo /proc/stat."""
    datos = {}
    with open("/proc/stat") as f:
        for linea in f:
            partes = linea.split()
            if partes[0].startswith("cpu") and partes[0] != "cpu":
                v = [int(x) for x in partes[1:]]
                datos[partes[0]] = (sum(v), v[3] + v[4])  # idle + iowait
    return datos


def contador(clave):
    with open("/proc/stat") as f:
        for linea in f:
            if linea.startswith(clave + " "):
                return int(linea.split()[1])
    return 0


def psi():
    """Devuelve {'some': {...}} de /proc/pressure/cpu o None si no existe."""
    try:
        with open("/proc/pressure/cpu") as f:
            res = {}
            for linea in f:
                tipo, *campos = linea.split()
                res[tipo] = {k: float(v) for k, v in (c.split("=") for c in campos)}
            return res
    except FileNotFoundError:
        return None


def main():
    p = argparse.ArgumentParser(description="Presión sobre la CPU")
    p.add_argument("-t", type=float, default=1.0, help="segundos de muestreo (1)")
    args = p.parse_args()
    if args.t <= 0:
        p.error("-t debe ser > 0")

    antes = cpus()
    time.sleep(args.t)
    despues = cpus()

    with open("/proc/loadavg") as f:
        l1, l5, l15, ejec, _ = f.read().split()
    listos, total = ejec.split("/")
    print(f"Carga media (1/5/15 min): {l1} {l5} {l15}")
    print(f"Procesos ejecutables ahora / existentes: {listos} / {total}")
    print(f"Procesos bloqueados esperando E/S: {contador('procs_blocked')}")
    print()
    print("Uso por CPU durante la muestra:")
    for nombre in sorted(despues, key=lambda c: int(c[3:])):
        dt = despues[nombre][0] - antes[nombre][0]
        di = despues[nombre][1] - antes[nombre][1]
        uso = 100 * (dt - di) / dt if dt else 0.0
        print(f"  {nombre}: {uso:5.1f} %")
    print()
    datos = psi()
    if datos is None:
        print("PSI no disponible (el kernel no tiene /proc/pressure/cpu).")
    else:
        s = datos["some"]
        print(f"PSI cpu 'some': {s['avg10']:.2f} % (10 s)  {s['avg60']:.2f} % (60 s)  {s['avg300']:.2f} % (300 s)")
        print("  'some' = porcentaje del tiempo en que al menos un proceso esperó CPU.")


if __name__ == "__main__":
    main()